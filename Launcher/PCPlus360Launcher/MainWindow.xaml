<Window x:Class="PCPlus360Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PC Plus 360"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border Background="#0a1628" CornerRadius="8" BorderThickness="1" BorderBrush="#1a2a44">
        <Grid>
            <!-- Invisible title bar for drag and window controls -->
            <Grid x:Name="TitleBar" Height="36" VerticalAlignment="Top" Panel.ZIndex="100"
                  Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="MinBtn" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="36" Height="28" Click="MinBtn_Click"
                            Background="Transparent" Foreground="#8899aa" BorderThickness="0"
                            Cursor="Hand"/>
                    <Button x:Name="MaxBtn" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="36" Height="28" Click="MaxBtn_Click"
                            Background="Transparent" Foreground="#8899aa" BorderThickness="0"
                            Cursor="Hand"/>
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="36" Height="28" Click="CloseBtn_Click"
                            Background="Transparent" Foreground="#8899aa" BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- WebView2 fills entire window -->
            <wv2:WebView2 x:Name="WebView" Margin="0"
                          DefaultBackgroundColor="#0a1628"/>

            <!-- Fallback message shown when WebView2 runtime is missing -->
            <Border x:Name="FallbackPanel" Visibility="Collapsed"
                    Background="#0a1628" Padding="60">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="WebView2 Runtime Required"
                               FontSize="24" FontWeight="SemiBold" Foreground="#00e5ff"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="14" Foreground="#8899aa" MaxWidth="500">
                        The Microsoft Edge WebView2 Runtime is required but not installed.
                        Please download and install it from:
                    </TextBlock>
                    <TextBlock x:Name="DownloadLink" Margin="0,12,0,0"
                               FontSize="14" Foreground="#00e5ff"
                               HorizontalAlignment="Center" Cursor="Hand"
                               TextDecorations="Underline"
                               MouseLeftButtonUp="DownloadLink_Click">
                        https://developer.microsoft.com/en-us/microsoft-edge/webview2/
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
